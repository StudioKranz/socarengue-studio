+interface StudioWorkflowBoardProps {
+  projectTitle: string;
+  issueTitle: string;
+  sceneCount: number;
+  artifactCount: number;
+  loreCount: number;
+}
+
+const priorityStyles: Record<StudioPriority, string> = {
